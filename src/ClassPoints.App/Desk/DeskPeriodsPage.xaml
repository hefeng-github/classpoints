<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassPoints.App.Desk.DeskPeriodsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,28">
        <StackPanel Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock Text="周期" Style="{StaticResource DeskH1Text}" />
                <TextBlock Text="周期是唯一的时间单位：每开一个新周期，榜单从零开始，旧记录一条不删。"
                           Style="{StaticResource DeskSecondaryText}" />
            </StackPanel>

            <!-- ===== 当前周期 ===== -->
            <Border Style="{StaticResource DeskCardBorder}">
                <StackPanel Spacing="14">
                    <Grid>
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="PeriodNameText" Style="{StaticResource DeskH2Text}" />
                            <TextBlock x:Name="PeriodRangeText" Style="{StaticResource DeskSecondaryText}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Content="重命名" Style="{StaticResource DeskButton}" Click="OnRename" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Name="EntryCountText" FontFamily="{StaticResource NumberFont}"
                                       FontSize="26" FontWeight="SemiBold" />
                            <TextBlock Text="本期记录条数" Style="{StaticResource DeskSecondaryText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="PointsText" FontFamily="{StaticResource NumberFont}"
                                       FontSize="26" FontWeight="SemiBold" />
                            <TextBlock Text="本期净发放" Style="{StaticResource DeskSecondaryText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock x:Name="TotalPointsText" FontFamily="{StaticResource NumberFont}"
                                       FontSize="26" FontWeight="SemiBold" />
                            <TextBlock Text="累计（总评口径）" Style="{StaticResource DeskSecondaryText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="2">
                            <TextBlock x:Name="PeriodIndexText" FontFamily="{StaticResource NumberFont}"
                                       FontSize="26" FontWeight="SemiBold" />
                            <TextBlock Text="已归档周期数" Style="{StaticResource DeskSecondaryText}" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{ThemeResource CardBgBrush}" CornerRadius="8" Padding="14">
                        <TextBlock Style="{StaticResource DeskSecondaryText}"
                                   Text="「本周期」只算这一轮，「累计」把历次周期加起来 —— 两个数不一样，都对。" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== 开新周期 ===== -->
            <Border Style="{StaticResource DeskCardBorder}">
                <StackPanel Spacing="12">
                    <TextBlock Text="开新周期" Style="{StaticResource DeskH2Text}" />
                    <TextBlock Style="{StaticResource DeskSecondaryText}"
                               Text="用于「这一轮评比结束了」。旧周期整包归档（Excel + 数据库副本），新周期按序号自动命名，成绩和名单都保留。" />
                    <Button Content="开始新周期…" Style="{StaticResource DeskPrimaryButton}"
                            HorizontalAlignment="Left" Height="34" Click="OnResetPeriod" />
                    <TextBlock x:Name="ResetHint" Style="{StaticResource DeskSecondaryText}" />
                </StackPanel>
            </Border>

            <!-- ===== 历史周期 ===== -->
            <Border Style="{StaticResource DeskCardBorder}" Padding="0">
                <StackPanel>
                    <Grid Padding="18,14,18,12">
                        <TextBlock Text="历史周期" Style="{StaticResource DeskH2Text}" />
                        <TextBlock x:Name="ArchiveHint" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Style="{StaticResource DeskSecondaryText}" />
                    </Grid>

                    <Grid Padding="18,0,18,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="周期" Style="{StaticResource DeskColumnHeader}" />
                        <TextBlock Grid.Column="1" Text="时间范围" Style="{StaticResource DeskColumnHeader}" />
                        <TextBlock Grid.Column="2" Text="记录数" Style="{StaticResource DeskColumnHeader}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="总分" Style="{StaticResource DeskColumnHeader}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="操作" Style="{StaticResource DeskColumnHeader}" />
                    </Grid>

                    <StackPanel x:Name="ArchiveList" />
                    <StackPanel x:Name="ArchiveEmpty" Padding="18,16" Visibility="Collapsed">
                        <TextBlock Text="还没有归档周期。开过一次新周期后，旧的会出现在这里。"
                                   Style="{StaticResource DeskSecondaryText}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
