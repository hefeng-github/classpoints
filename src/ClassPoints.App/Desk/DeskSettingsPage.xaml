<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassPoints.App.Desk.DeskSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ClassPoints.App.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,28">
        <StackPanel Spacing="16">
            <Grid>
                <StackPanel Spacing="4">
                    <TextBlock Text="设置" Style="{StaticResource DeskH1Text}" />
                    <TextBlock x:Name="SubText" Style="{StaticResource DeskSecondaryText}" />
                </StackPanel>
            </Grid>

            <StackPanel x:Name="Sections" Spacing="14" />
        </StackPanel>
    </ScrollViewer>
</Page>
