<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ClassPoints.App.Desk.DeskShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ClassPoints.App.Controls">

    <!--
        电脑端的样子：左侧常驻文字导航、行高 40 —— 键鼠密度，一眼能扫完十项。
        大屏端相反：左侧只有 56 宽的图标轨。两端导航项一模一样（AppNav），
        差别只在排版，所以「大屏上能做的事，在这儿也能做」是结构性保证，不是靠人记。

        导航项内部是「24 宽图标格 + 文字」：图标中心固定在第 12 像素，
        文字从同一列起排，换了图标或加了图标都不会让文字左右跳。
    -->
    <Grid Background="{ThemeResource BoardBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{ThemeResource CardBgBrush}"
                BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="20,20,20,12" Spacing="3">
                    <TextBlock x:Name="ClassNameText" Style="{StaticResource DeskH2Text}"
                               FontSize="18" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PeriodText" Style="{StaticResource DeskSecondaryText}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <Border Background="{ThemeResource TileBgBrush}" CornerRadius="4"
                            Padding="6,2" HorizontalAlignment="Left" Margin="0,6,0,0">
                        <TextBlock x:Name="ModeText" Style="{StaticResource DeskSecondaryText}" FontSize="11" />
                    </Border>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,0">
                    <StackPanel x:Name="NavStack" Spacing="2" />
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="16,0,16,14" Spacing="8">
                    <controls:IdentityChip x:Name="IdentityChip" HorizontalAlignment="Stretch" />
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="BackupText" Style="{StaticResource DeskSecondaryText}" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource DeskSecondaryText}" />
                        <!-- 有新版本时的常驻提示。放在侧栏底部而不是弹窗：
                             更新不该打断上课，但也不能让人永远看不见。 -->
                        <HyperlinkButton x:Name="UpdateBadge" Visibility="Collapsed"
                                         Padding="0" Margin="0,-2,0,0" Click="OnUpdateBadgeClick">
                            <TextBlock x:Name="UpdateBadgeText" Style="{StaticResource DeskSecondaryText}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </HyperlinkButton>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Frame x:Name="DeskFrame" Grid.Column="1" />

        <!-- 认人覆盖层：电脑端只在真的需要时出现（默认是班主任身份） -->
        <Grid x:Name="IdentifyLayer" Grid.ColumnSpan="2" Visibility="Collapsed"
              Background="{ThemeResource ScrimBrush}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="520" Padding="30"
                    Background="{ThemeResource CardBgBrush}"
                    BorderBrush="{ThemeResource CardStrokeBrush}"
                    BorderThickness="1" CornerRadius="16">
                <StackPanel Spacing="16">
                    <TextBlock x:Name="IdentifyTitle" Text="请输入密码" Style="{StaticResource DeskH1Text}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="IdentifySub" Text="谁输对了密码，就按谁的身份记。"
                               Style="{StaticResource DeskSecondaryText}"
                               TextAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Button Content="输密码" Style="{StaticResource DeskButton}" Click="OnIdentifyPinClick" />
                        <Button Content="取消" Style="{StaticResource DeskButton}" Click="OnIdentifyCancelClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <controls:PinPad x:Name="Pin" Grid.ColumnSpan="2" />
        <controls:Toast x:Name="ToastLayer" Grid.ColumnSpan="2" />
    </Grid>
</UserControl>
