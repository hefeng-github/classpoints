<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassPoints.App.Desk.DeskSeatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        座位表：可选功能，设置里打开才有这一页。
        教室按「排 × 组 × 每组座位」画，组与组之间留出走廊，讲台在最前面。
        点座位选中、再点另一个交换；点空位把选中的人放过去 —— 鼠标和触屏同一套动作，
        不额外做拖拽：教室里手掌压屏、拖到一半滑出边界都是常事，点两下反而稳。
    -->
    <Grid Padding="24,20,24,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="座位表" Style="{StaticResource DeskH1Text}" />
            <TextBlock x:Name="SubText" Style="{StaticResource DeskSecondaryText}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- ===== 工具条 ===== -->
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ArrangeButton" Content="自动排座" Style="{StaticResource DeskButton}">
                    <Button.Flyout>
                        <MenuFlyout x:Name="StrategyMenu" Placement="BottomEdgeAlignedLeft" />
                    </Button.Flyout>
                </Button>
                <Button Content="教室布局" Style="{StaticResource DeskButton}" Click="OnEditLayout" />
                <Button Content="座次表" Style="{StaticResource DeskButton}">
                    <Button.Flyout>
                        <MenuFlyout x:Name="SheetMenu" Placement="BottomEdgeAlignedLeft" />
                    </Button.Flyout>
                </Button>
                <Button Content="快照" Style="{StaticResource DeskButton}" Click="OnSnapshots" />
                <Button x:Name="UndoButton" Content="撤销" Style="{StaticResource DeskButton}"
                        IsEnabled="False" Click="OnUndo" />
                <Button x:Name="RedoButton" Content="重做" Style="{StaticResource DeskButton}"
                        IsEnabled="False" Click="OnRedo" />
                <Button Content="清空座位" Style="{StaticResource DeskButton}" Click="OnClearSeats" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock x:Name="DirtyText" Text="有改动未保存" Style="{StaticResource DeskSecondaryText}"
                           VerticalAlignment="Center" Visibility="Collapsed" />
                <Button x:Name="SaveButton" Content="保存" Style="{StaticResource DeskPrimaryButton}"
                        IsEnabled="False" Click="OnSave" />
            </StackPanel>
        </Grid>

        <!-- ===== 选中提示 ===== -->
        <Border x:Name="SelectionBar" Grid.Row="2" Visibility="Collapsed"
                Background="{ThemeResource AccentBgBrush}" BorderBrush="{ThemeResource SelectStrokeBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SelectionText" Style="{StaticResource DeskBodyText}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="约束…" Style="{StaticResource DeskButton}" Height="30" Click="OnEditRules" />
                    <Button x:Name="PinButton" Content="固定此座" Style="{StaticResource DeskButton}"
                            Height="30" Click="OnTogglePin" />
                    <Button Content="清空此座" Style="{StaticResource DeskButton}" Height="30" Click="OnClearSeat" />
                    <Button Content="取消选择" Style="{StaticResource DeskButton}" Height="30" Click="OnDeselect" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 教室 ===== -->
        <Border Grid.Row="3" Style="{StaticResource DeskCardBorder}" Padding="14">
            <ScrollViewer x:Name="SeatScroll" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" ZoomMode="Disabled">
                <StackPanel Spacing="10" HorizontalAlignment="Center" MinWidth="560">
                    <Border Background="{ThemeResource TileBgBrush}" CornerRadius="8" Padding="0,6"
                            BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1">
                        <TextBlock Text="讲 台" Style="{StaticResource DeskSecondaryText}"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <Grid x:Name="SeatGrid" ColumnSpacing="4" RowSpacing="4" />

                    <TextBlock x:Name="HintText" Style="{StaticResource DeskSecondaryText}"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Text="点一个座位选中，再点另一个交换；点空位把选中的学生放过去。" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===== 未排座 ===== -->
        <Border Grid.Row="4" Style="{StaticResource DeskCardBorder}" Padding="12,10">
            <StackPanel Spacing="6">
                <TextBlock x:Name="UnseatedTitle" Text="未排座" Style="{StaticResource DeskColumnHeader}" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              MaxHeight="80">
                    <StackPanel x:Name="UnseatedList" Orientation="Horizontal" Spacing="8" />
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Page>
