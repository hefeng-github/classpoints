<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ClassPoints.App.Controls.IdentityChip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <!--
        当前身份胶囊。凡是要身份的页面，标题行右边都挂一个 —— 不是装饰：
        教室里两个班委轮流记分，谁忘了换人就会把分记到别人头上。
    -->
    <Border x:Name="Root"
            Background="{ThemeResource TileBgBrush}"
            BorderBrush="{ThemeResource CardStrokeBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="10,4,4,4">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Border x:Name="Avatar" Width="26" Height="26" CornerRadius="13"
                    Background="{ThemeResource SelectStrokeBrush}" VerticalAlignment="Center">
                <TextBlock x:Name="AvatarText" Text="?"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{ThemeResource OnAccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel VerticalAlignment="Center" Spacing="0">
                <TextBlock x:Name="NameText" Text="未认人"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock x:Name="RoleText" Text="只能查看"
                           FontSize="11"
                           Foreground="{ThemeResource TextSecondaryBrush}" MaxLines="1" />
            </StackPanel>

            <Button x:Name="SwitchButton" Content="切换"
                    Height="30" MinWidth="56" Padding="10,0" CornerRadius="15"
                    FontSize="12"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{ThemeResource SelectStrokeBrush}"
                    Click="OnSwitchClick" />
        </StackPanel>
    </Border>
</UserControl>
