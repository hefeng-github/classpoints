<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ClassPoints.App.Controls.Toast"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">

    <!--
        提示条 = 原生 InfoBar。以前是一个手写的圆角 Border + TextBlock：
        没有图标、没有语义色，和系统的通知样式也对不上。InfoBar 自带信息图标、
        自动配色、展开/收起动画；关掉 IsClosable 就成了一块只会自己消失的提示。

        IsHitTestVisible=False：它浮在页面顶上，不能挡住下面的按钮。
    -->
    <InfoBar x:Name="Bar"
             Severity="Informational"
             IsOpen="False"
             IsClosable="False"
             HorizontalAlignment="Center"
             VerticalAlignment="Top"
             Margin="0,72,0,0"
             MinWidth="320"
             MaxWidth="760"
             Background="{ThemeResource CardBgBrush}"
             BorderBrush="{ThemeResource CardStrokeBrush}"
             BorderThickness="1"
             CornerRadius="8" />
</UserControl>
